<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.min.edu.model.mapper.ProblemMapper">

    <select id="selectAllProblems" resultType="com.min.edu.dto.ProblemDto">
        SELECT 
            problem_id, 
            title, 
            content, 
            initial_code, 
            type, 
            difficulty, 
            category, 
            source
        FROM problems
        ORDER BY difficulty ASC
    </select>

</mapper>